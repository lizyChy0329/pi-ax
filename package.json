{
  "name": "@lizychy0329/pi-ax",
  "version": "0.0.4",
  "description": "ax integration for pi: structured web extraction via CSS selectors and HTTP API calls",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-skill",
    "web",
    "extraction",
    "scraping",
    "ax"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lizyChy0329/pi-ax"
  },
  "homepage": "https://github.com/lizyChy0329/pi-ax#readme",
  "files": [
    "src/**/*.ts",
    "skills/**",
    "assets/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "bumpp --tag --commit --push",
    "release:dry-run": "bumpp --tag --commit --dry-run",
    "publish:npm": "npm publish --access public"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ],
    "skills": [
      "./skills/ax/SKILL.md"
    ]
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "bumpp": "^10.1.2",
    "typebox": "^1.3.19",
    "vitest": "^4.1.11"
  }
}
