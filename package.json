{
  "name": "pi-ax",
  "version": "0.0.1",
  "description": "ax integration for pi: structured web extraction via CSS selectors and HTTP API calls",
  "keywords": ["pi-package", "pi-extension", "pi-skill", "web", "extraction", "scraping", "ax"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lizyChy0329/pi-ax"
  },
  "homepage": "https://github.com/lizyChy0329/pi-ax#readme",
  "files": [
    "src/**/*.ts",
    "skills/**",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "release": "bumpp --tag --commit --push",
    "release:dry-run": "bumpp --tag --commit --dry-run",
    "publish:npm": "npm publish"
  },
  "pi": {
    "extensions": ["./src/index.ts"],
    "skills": ["./skills/ax/SKILL.md"]
  },
  "devDependencies": {
    "bumpp": "^10.1.2"
  }
}